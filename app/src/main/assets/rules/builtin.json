{
  "version": 2,
  "rules": [
    {
      "id": "generic.splash.skip",
      "layer": "generic",
      "priority": 10,
      "enabled": true,
      "window": {
        "fullscreen": true,
        "launchAgeMsMax": 8000,
        "excludeIfImeVisible": true
      },
      "match": {
        "any": [
          {
            "textRegex": "^(跳过|跳过广告|skip)(\\s*\\d+\\s*[sS]?)?$"
          },
          {
            "textRegex": "^(跳过广告|跳过)[\\s\\S]{0,6}$"
          },
          {
            "textContains": "跳过",
            "clickable": true,
            "region": "top_right",
            "minAreaDp2": 16
          }
        ]
      },
      "guard": {
        "cooldownMs": 800,
        "maxActionsPerWindow": 1,
        "forbidTextRegex": "下载|安装|详情|查看|立即|领取|打开|允许|同意|确认|继续|授权|更新|升级|购买|支付|充值|开通|关注|订阅|签到|直播|购物车|优惠券|客服|评价|分享|邀请"
      },
      "action": {
        "type": "click",
        "fallback": "gesture-center"
      },
      "evidence": "通用语义层：覆盖未抓过 XML 的 App"
    },
    {
      "id": "generic.splash.close",
